{
  "name": "al-project-assistant",
  "displayName": "AL Project Assistant",
  "description": "AL workspace and agent documentation scaffolding",
  "version": "0.0.1",
  "private": true,
  "publisher": "local-development",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:alProjectAssistant.setup"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alProjectAssistant.setup",
        "title": "AL Project Assistant: Setup Project"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "package": "vsce package --allow-missing-repository",
    "test:host": "npm run compile && node tests/run-host.cjs",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.90.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.0.0"
  }
}
